      },
      "display-md": {
        "size": "clamp(28px, 3.2vw, 44px)",
        "lineHeight": 1.16,
        "weight": 600,
        "tracking": "0",
        "family": "display"
      },
      "display-xl": {
        "size": "clamp(40px, 6.4vw, 88px)",
        "lineHeight": 1.06,
        "weight": 600,
        "tracking": "0",
        "family": "display"
      },
      "mono-body": {
        "size": "14px",
        "lineHeight": 1.6,
        "weight": 400,
        "tracking": "0",
        "family": "mono"
      },
      "mono-display": {
        "size": "clamp(28px, 7vw, 40px)",
        "lineHeight": 1.1,
        "weight": 500,
        "tracking": "0.08em",
        "family": "mono"
      },
      "mono-sm": {
        "size": "13px",
        "lineHeight": 1.6,
        "weight": 400,
        "tracking": "0",
        "family": "mono"
      },
      "sm": {
        "size": "14px",
        "lineHeight": 1.55,
        "weight": 400,
        "tracking": "0",
        "family": "body"
      },
      "title-lg": {
        "size": "22px",
        "lineHeight": 1.3,
        "weight": 600,
        "tracking": "-0.01em",
        "family": "body"
      },
      "title-md": {
        "size": "22px",
        "lineHeight": 1.3,
        "weight": 600,
        "tracking": "-0.01em",
        "family": "body"
      },
      "title-sm": {
        "size": "18px",
        "lineHeight": 1.4,
        "weight": 600,
        "tracking": "0",
        "family": "body"
