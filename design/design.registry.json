{
  "$schema": "../schema/design.registry.schema.json",
  "meta": {
    "name": "khepri-tool",
    "displayName": "石灰岩与青铜",
    "version": "0.2.0",
    "tier": "showcase",
    "locale": "zh-CN",
    "description": "自托管加密粘贴工具的界面。工具页而非营销页：深色单主题，暖灰石灰岩底，青铜色只做强调。无紫、无渐变文字、无外发光。",
    "inspiration": [
      "brand-pages 的 token 纪律与 lint 底线",
      "界面气质取自旧工具与出土器物的手感，不取自机房冷光"
    ]
  },
  "direction": {
    "product": "khepri：自托管的加密粘贴服务。粘贴一段命令或脚本，拿到一个能重新敲一遍的短链接；服务端只存密文，密钥在浏览器里派生。给需要在受限终端之间传递命令的人。",
    "character": [
      "克制",
      "精密",
      "安静"
    ],
    "world": "石灰岩与青铜：墓室墙面那种偏暖的深灰，器物上氧化后的青铜色。不是机房的冷光，是手掌里一件旧工具的质感。",
    "moments": [
      "加密完成、链接出现的一刻",
      "对方输对密码、明文完整铺开的一刻"
    ],
    "signature": "链接区像一块出土的铭牌：短码用等宽字单独成行，四周留白，Copy 按钮像牌座而非悬浮控件。"
  },
