      "minBodyPx": 16,
      "minTextPx": 12,
      "cjkDisplayTracking": "0",
      "maxLineLengthCh": 68,
      "noItalicForCjk": true
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80,
      "24": 96
    },
    "layout": {
      "containerMax": 960,
      "gutter": "clamp(16px, 4vw, 32px)",
      "sectionY": "clamp(24px, 5vw, 48px)"
    }
  },
  "radius": {
    "none": 0,
    "xs": 3,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "shadow": {
    "dark": {
      "1": {
        "surface": "{neutral.900}",
        "shadow": "inset 0 1px 0 rgb(255 255 255 / 0.04), 0 0 0 0.5px rgb(255 255 255 / 0.06), 0 1px 2px rgb(0 0 0 / 0.4)"
      },
      "2": {
        "surface": "{neutral.850}",
        "shadow": "inset 0 1px 0 rgb(255 255 255 / 0.05), 0 0 0 0.5px rgb(255 255 255 / 0.08), 0 8px 24px -8px rgb(0 0 0 / 0.5)"
      },
      "3": {
        "surface": "{neutral.800}",
        "shadow": "inset 0 1px 0 rgb(255 255 255 / 0.06), 0 0 0 0.5px rgb(255 255 255 / 0.09), 0 20px 40px -16px rgb(0 0 0 / 0.6)"
      },
      "4": {
        "surface": "{neutral.700}",
        "shadow": "inset 0 1px 0 rgb(255 255 255 / 0.07), 0 0 0 0.5px rgb(255 255 255 / 0.1), 0 32px 64px -24px rgb(0 0 0 / 0.7)"
      }
    },
    "light": {
      "1": "0 0 0 0.5px rgb(23 20 15 / 0.08), 0 1px 2px rgb(23 20 15 / 0.06)",
      "2": "0 0 0 0.5px rgb(23 20 15 / 0.08), 0 4px 8px -2px rgb(23 20 15 / 0.08)",
      "3": "0 0 0 0.5px rgb(23 20 15 / 0.08), 0 8px 16px -4px rgb(23 20 15 / 0.10)",
      "4": "0 0 0 0.5px rgb(23 20 15 / 0.08), 0 16px 32px -8px rgb(23 20 15 / 0.14)"
    }
  },
  "motion": {
    "durations": {
      "instant": 120,
      "fast": 200,
      "base": 320,
      "slow": 400
    },
    "maxMs": 500,
    "easings": {
      "out": "cubic-bezier(.2,.8,.2,1)",
      "in": "cubic-bezier(.4,0,1,1)",
      "inOut": "cubic-bezier(.65,0,.35,1)"
    },
    "entrance": {
      "durationMs": 400,
      "maxMs": 700,
      "once": true,
      "staggerMs": 50,
      "staggerMax": 6,
      "rise": "8px"
    },
    "loops": {
      "spinnerMs": 800,
      "ambientMinMs": 8000,
      "ambientMaxMs": 20000,
      "pauseOffscreen": true
    },
    "moments": {
      "maxMs": 1200
    },
    "pressScale": 0.98,
    "animatable": {
      "keyframes": [
        "transform",
        "opacity"
      ],
      "transitions": [
        "transform",
        "opacity",
        "color",
        "background-color",
        "border-color",
        "outline-color",
        "fill",
        "stroke"
      ],
      "exceptions": []
    },
    "reducedMotion": {
      "strategy": "final-state",
      "keep": [
        "颜色 / 底色反馈",
        "焦点环"
      ],
      "drop": [
        "位移",
        "缩放",
        "模糊",
        "循环背景"
      ]
    }
  },
  "effects": {
    "vocabulary": "brand-pages/effects@0.2.0",
    "limits": {
      "style": 1,
      "accent": 3,
      "ambientLoops": 0
    },
    "allow": [
      {
        "id": "click-ripple",
        "role": "accent",
        "where": "主按钮 Create / Decrypt",
        "params": {
          "durationMs": 320,
          "trigger": "click"
        },
        "reason": "加密要跑几百毫秒，点击瞬间给一个物理回应，避免像卡死。"
      },
      {
        "id": "stagger-in",
        "role": "accent",
        "where": "表单字段首次入场",
        "params": {
          "durationMs": 400,
          "staggerMs": 50
        },
        "reason": "五个字段一次出现会显得拥挤，错开 50ms 让阅读顺序自然。"
      },
      {
        "id": "skeleton",
        "role": "functional",
        "where": "加密与解密等待期",
        "params": {
          "shimmerMs": 1200
        },
        "reason": "PBKDF2 20 万次迭代在慢机器上可超过一秒，必须有可见等待态。"
      }
    ],
    "forbid": [
      "particles",
      "cta-shimmer-pulse",
      "neumorphism",
      "cursor-trail",
      "border-beam",
      "retro-grid",
      "liquid-morph",
      "aurora-bg",
      "noise-grain"
    ],
    "conditional": {}
  },
  "components": {
    "button": {
      "sizes": {
        "md": {
          "height": 40,
          "paddingX": 16,
          "fontSize": "sm",
          "radius": "md",
          "gap": 8
        },
        "sm": {
          "height": 32,
          "paddingX": 12,
          "fontSize": "xs",
          "radius": "sm",
          "gap": 6
        },
        "lg": {
          "height": 48,
          "paddingX": 24,
          "fontSize": "body",
          "radius": "md",
          "gap": 8
        }
      },
      "fontWeight": 500,
      "variants": {
        "primary": {
          "bg": "@primary",
          "fg": "@on-primary",
          "border": "transparent",
          "hover": {
            "bg": "@primary-hover"
          },
          "active": {
            "bg": "@primary-active"
          }
        },
        "ghost": {
          "bg": "transparent",
          "fg": "@text-muted",
          "border": "@border",
          "hover": {
            "bg": "@surface-raised",
            "fg": "@text"
          },
          "active": {
            "bg": "@surface-sunken"
          }
        },
        "secondary": {
          "bg": "@surface",
          "fg": "@text",
          "border": "@border-strong",
          "hover": {
            "bg": "@bg-subtle"
          },
          "active": {
            "bg": "@surface-sunken"
          }
        },
        "danger": {
          "bg": "@danger",
          "fg": "@on-danger",
          "border": "transparent",
          "hover": {
            "bg": "@danger-hover"
          },
          "active": {
            "bg": "@danger-active"
          }
        }
      },
      "states": {
        "focusVisible": {
          "ring": "0 0 0 2px @bg, 0 0 0 4px @focus-ring",
          "note": "只在 :focus-visible 显示"
        },
        "active": {
          "scale": 0.98
        },
        "disabled": {
          "bg": "@disabled-bg",
          "fg": "@disabled-text",
          "border": "transparent",
          "cursor": "not-allowed",
          "note": "不用 opacity 冒充禁用；aria-disabled 时仍可聚焦"
        },
        "loading": {
          "spinnerPx": 14,
          "spinnerStrokePx": 2,
          "spinnerMs": 800,
          "keepWidth": true,
          "ariaBusy": true,
          "label": "保留原文案并在前面加转圈，按钮宽度不变"
        }
      },
      "motion": {
        "duration": "fast",
        "easing": "out",
        "properties": [
          "background-color",
          "border-color",
          "color",
          "transform"
        ]
      },
      "rules": [
        "每个视口最多 1 个实心主按钮",
        "按钮文案用动词开头",
        "最小点击区域 32×32",
        "等待态保留按钮宽度，避免布局跳动"
      ]
    },
    "input": {
      "height": 44,
      "paddingX": 14,
      "radius": "md",
      "fontSize": "sm",
      "bg": "@surface-sunken",
      "fg": "@text",
      "placeholder": "@placeholder",
      "border": "@border-strong",
      "hover": {
        "border": "@border-strong"
      },
      "focus": {
        "border": "@focus-ring",
        "ring": "0 0 0 3px @focus-ring/0.24"
      },
      "error": {
        "border": "@danger",
        "ring": "0 0 0 3px @danger/0.2",
        "message": "@danger-text"
      },
      "disabled": {
        "bg": "@disabled-bg",
        "fg": "@disabled-text",
        "border": "@border"
      },
      "label": {
        "fontSize": "sm",
        "weight": 500,
        "color": "@text",
        "required": "visible"
      },
      "help": {
        "fontSize": "xs",
        "color": "@text-muted"
      },
      "rules": [
        "每个输入框必须有可见 <label>，placeholder 只放示例",
        "错误信息写在输入框下方，用 aria-describedby 关联",
        "多行文本区允许 resize: vertical"
      ]
    },
    "card": {
      "bg": "@surface",
      "border": "@border",
      "radius": "lg",
      "padding": 20,
      "shadow": "1",
      "hover": {
        "shadow": "2",
        "lift": "-2px"
      },
      "rules": [
        "同一层卡片用同一档阴影",
        "本页只有结果区一张卡"
      ]
    },
    "toast": {
      "radius": "md",
      "padding": 12,
      "shadow": "2",
      "bg": "@surface-raised",
      "fg": "@text",
      "fgMuted": "@text-muted",
      "durationMs": 5000,
      "variants": {
        "success": {
          "accent": "@success"
        },
        "warning": {
          "accent": "@warning"
        },
        "danger": {
          "accent": "@danger"
        }
      },
      "rules": [
        "错误类不自动消失",
        "role=status，错误用 role=alert"
      ]
    },
    "navbar": {
      "height": 64,
      "bg": "@bg/0.82",
      "bgScrolled": "@surface/0.9",
      "blurPx": 12,
      "border": "@border",
      "link": "@text-muted",
      "linkActive": "@text",
      "rules": [
        "本页无导航栏；字段保留以满足 schema，不渲染"
      ]
    },
    "footer": {
      "bg": "@inverse-bg",
      "fg": "@inverse-text",
      "fgMuted": "@inverse-text-muted",
      "border": "@inverse-border",
      "rules": [
        "本页无页脚；字段保留以满足 schema，不渲染"
      ]
    },
    "cta": {
      "bg": "@hero-bg",
      "fg": "@hero-text",
      "fgMuted": "@hero-text-muted",
      "radius": "lg",
      "padding": 48,
      "rules": [
        "本页无 CTA 区块；字段保留以满足 schema，不渲染"
      ]
    },
    "hero": {
      "bg": "@hero-bg",
      "fg": "@hero-text",
      "fgMuted": "@hero-text-muted",
